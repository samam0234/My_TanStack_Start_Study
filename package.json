{
  "name": "tanstack-start-study",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite dev --port 5173",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "mcp:server": "node scripts/mcp-server.mjs",
    "mcp:client": "node scripts/mcp-client.mjs",
    "db:copy": "tsx --env-file-if-exists=.env scripts/copy-db.ts",
    "db:mongo": "node --env-file-if-exists=.env scripts/mongo-posts.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.122",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.7",
    "ai": "7.0.181",
    "better-sqlite3": "13.2.0",
    "knex": "3.3.0",
    "mongodb": "7.9.1",
    "mysql2": "3.24.6",
    "nitro": "3.0.261103-rc",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.2.0",
    "swagger-ui-dist": "5.36.0",
    "tsx": "4.23.15",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
